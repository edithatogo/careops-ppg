          "type": "Text",
          "required": true,
          "unique": false,
          "schemaXml": "<Field Type=\"Text\" Name=\"ProposedModule\" StaticName=\"ProposedModule\" DisplayName=\"ProposedModule\" Required=\"TRUE\"></Field>"
        },
        {
          "name": "SourceProvenance",
          "type": "Note",
          "required": true,
          "unique": false,
          "schemaXml": "<Field Type=\"Note\" Name=\"SourceProvenance\" StaticName=\"SourceProvenance\" DisplayName=\"SourceProvenance\" Required=\"TRUE\" RichText=\"FALSE\"></Field>"
        },
        {
          "name": "ReviewText",
          "type": "Note",
          "required": false,
          "unique": false,
          "schemaXml": "<Field Type=\"Note\" Name=\"ReviewText\" StaticName=\"ReviewText\" DisplayName=\"ReviewText\" Required=\"FALSE\" RichText=\"FALSE\"></Field>"
        },
        {
