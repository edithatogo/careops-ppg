      "fields": [
        {
          "name": "ContentKey",
          "type": "Text",
          "required": true,
          "unique": true,
          "schemaXml": "<Field Type=\"Text\" Name=\"ContentKey\" StaticName=\"ContentKey\" DisplayName=\"ContentKey\" Required=\"TRUE\" Indexed=\"TRUE\" EnforceUniqueValues=\"TRUE\"></Field>"
        },
        {
          "name": "DocumentUID",
          "type": "Text",
          "required": true,
          "unique": false,
          "schemaXml": "<Field Type=\"Text\" Name=\"DocumentUID\" StaticName=\"DocumentUID\" DisplayName=\"DocumentUID\" Required=\"TRUE\"></Field>"
        },
        {
          "name": "SourceEditionKey",
          "type": "Text",
          "required": true,
          "unique": false,
          "schemaXml": "<Field Type=\"Text\" Name=\"SourceEditionKey\" StaticName=\"SourceEditionKey\" DisplayName=\"SourceEditionKey\" Required=\"TRUE\"></Field>"
        },
        {
          "name": "SourceElementId",
          "type": "Text",
          "required": true,
          "unique": false,
          "schemaXml": "<Field Type=\"Text\" Name=\"SourceElementId\" StaticName=\"SourceElementId\" DisplayName=\"SourceElementId\" Required=\"TRUE\"></Field>"
        },
        {
          "name": "SourceOrdinal",
          "type": "Number",
          "required": true,
          "unique": false,
