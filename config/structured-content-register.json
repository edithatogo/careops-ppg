          "required": true,
          "unique": false,
          "schemaXml": "<Field Type=\"Choice\" Name=\"BlockReviewState\" StaticName=\"BlockReviewState\" DisplayName=\"BlockReviewState\" Required=\"TRUE\"><CHOICES><CHOICE>Unreviewed</CHOICE><CHOICE>Needs reconciliation</CHOICE><CHOICE>Reviewed</CHOICE></CHOICES><Default>Unreviewed</Default></Field>"
        },
        {
          "name": "OptionalModifiers",
          "type": "Note",
          "required": false,
          "unique": false,
          "schemaXml": "<Field Type=\"Note\" Name=\"OptionalModifiers\" StaticName=\"OptionalModifiers\" DisplayName=\"OptionalModifiers\" Required=\"FALSE\" RichText=\"FALSE\"></Field>"
