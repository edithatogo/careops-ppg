{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {}
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Every_15_minutes": {
          "recurrence": {
            "frequency": "Minute",
            "interval": 15,
            "timeZone": "E. Australia Standard Time"
          },
          "evaluatedRecurrence": {
            "frequency": "Minute",
            "interval": 15,
            "timeZone": "E. Australia Standard Time"
          },
          "type": "Recurrence",
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Project": {
          "actions": {
            "Read_source": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "__PPG_INSTALL_00101__",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/GetFileByServerRelativePath(decodedurl='__PPG_INSTALL_00084__/qw3-source-state.json')/$value",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Source": {
              "runAfter": {
                "Read_source": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(contains(body('Read_source'),'$content'),json(base64ToString(body('Read_source')?['$content'])),json(string(body('Read_source'))))"
            },
            "Read_checkpoint": {
              "runAfter": {
                "Source": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "__PPG_INSTALL_00101__",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/GetFileByServerRelativePath(decodedurl='__PPG_INSTALL_00084__/qw3-last-successful.json')/$value",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Checkpoint": {
              "runAfter": {
                "Read_checkpoint": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(contains(body('Read_checkpoint'),'$content'),json(base64ToString(body('Read_checkpoint')?['$content'])),json(string(body('Read_checkpoint'))))"
            },
            "List_attempts": {
              "runAfter": {
                "Checkpoint": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "__PPG_INSTALL_00101__",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/GetFolderByServerRelativePath(decodedurl='__PPG_INSTALL_00084__')/Files?$select=Name,TimeLastModified&$filter=startswith(Name,'qw3-run-')&$orderby=TimeLastModified desc&$top=1",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Read_attempt": {
              "runAfter": {
                "List_attempts": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "__PPG_INSTALL_00101__",
                  "parameters/method": "GET",
                  "parameters/uri": "@concat('_api/web/GetFileByServerRelativePath(decodedurl=''__PPG_INSTALL_00084__/',first(body('List_attempts')?['value'])?['Name'],''')/$value')",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Attempt": {
              "runAfter": {
                "Read_attempt": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(contains(body('Read_attempt'),'$content'),json(base64ToString(body('Read_attempt')?['$content'])),json(string(body('Read_attempt'))))"
            },
            "Changed": {
              "runAfter": {
                "Attempt": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@not(equals(outputs('Source')?['sourceETag'],outputs('Checkpoint')?['centralSourceETag']))"
            },
            "Recent_failure": {
              "runAfter": {
                "Changed": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@and(equals(outputs('Attempt')?['status'],'failed_partial_or_unverified'),greater(ticks(coalesce(outputs('Attempt')?['asOfUtc'],'__PPG_INSTALL_00242__')),ticks(outputs('Checkpoint')?['asOfUtc'])))"
            },
            "Health": {
              "runAfter": {
                "Recent_failure": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(not(and(not(empty(outputs('Source')?['sourceETag'])),not(empty(outputs('Checkpoint')?['centralSourceETag'])),equals(outputs('Checkpoint')?['status'],'completed'),or(equals(outputs('Attempt')?['status'],'completed'),equals(outputs('Attempt')?['status'],'running'),equals(outputs('Attempt')?['status'],'failed_partial_or_unverified')),not(empty(outputs('Attempt')?['asOfUtc'])),lessOrEquals(ticks(outputs('Attempt')?['asOfUtc']),ticks(utcNow())),greaterOrEquals(outputs('Checkpoint')?['readbackCount'],1),lessOrEquals(ticks(outputs('Source')?['checkedUtc']),ticks(utcNow())),lessOrEquals(ticks(outputs('Checkpoint')?['asOfUtc']),ticks(utcNow())))),'unknown',if(outputs('Changed'),if(and(outputs('Recent_failure'),not(equals(outputs('Attempt')?['attemptedWrites'],0))),'failed','held'),if(outputs('Recent_failure'),'failed',if(greater(ticks(utcNow()),ticks(addMinutes(outputs('Source')?['checkedUtc'],90))),'unknown','healthy'))))"
            },
            "Projection": {
              "runAfter": {
                "Health": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": {
                "Title": "Source catalogue refresh",
                "Health": "@outputs('Health')",
                "LatestCheck": "@outputs('Source')?['checkedUtc']",
                "LatestAttemptOutcome": "@outputs('Attempt')?['status']",
                "LastSuccessfulReconciliation": "@outputs('Checkpoint')?['asOfUtc']",
                "ObservedVersion": "@outputs('Source')?['sourceETag']",
                "CommittedVersion": "@outputs('Checkpoint')?['centralSourceETag']",
                "CommittedCount": "@outputs('Checkpoint')?['readbackCount']",
                "ProjectedAt": "@utcNow()",
                "Reason": "@if(equals(outputs('Health'),'held'),'Source change detected\u2014reconciliation held',if(equals(outputs('Health'),'failed'),'Latest reconciliation failed or remains unverified; last successful baseline retained',if(equals(outputs('Health'),'healthy'),'Latest observed source matches the last verified reconciliation','Evidence missing, inconsistent or source check overdue')))",
                "NextAction": "@if(equals(outputs('Health'),'healthy'),'None','Inspect source-sync evidence; resolve identity exceptions through the existing identity contract. Do not extend the ledger automatically.')",
                "EvidenceLink": "@concat('__PPG_INSTALL_00133__ Review Evidence/',first(body('List_attempts')?['value'])?['Name'])"
              }
            },
            "Update_status": {
              "runAfter": {
                "Projection": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "__PPG_INSTALL_00101__",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'__PPG_INSTALL_00099__')/__PPG_INSTALL_00269__",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata",
                    "IF-MATCH": "*",
                    "X-HTTP-Method": "MERGE"
                  },
                  "parameters/body": "@string(outputs('Projection'))"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {},
          "type": "Scope"
        },
        "Unknown_on_failure": {
          "runAfter": {
            "Project": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "__PPG_INSTALL_00101__",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists(guid'__PPG_INSTALL_00099__')/__PPG_INSTALL_00269__",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json;odata=nometadata",
                "IF-MATCH": "*",
                "X-HTTP-Method": "MERGE"
              },
              "parameters/body": "{\"Title\": \"Source catalogue refresh\", \"Health\": \"unknown\", \"LatestCheck\": null, \"LatestAttemptOutcome\": \"Evidence read or validation failed\", \"LastSuccessfulReconciliation\": null, \"ObservedVersion\": null, \"CommittedVersion\": null, \"CommittedCount\": null, \"ProjectedAt\": \"@{utcNow()}\", \"Reason\": \"Evidence read, parse or consistency check failed; no healthy result inferred\", \"NextAction\": \"Inspect projection flow and source-sync evidence\", \"EvidenceLink\": \"__PPG_INSTALL_00133__ Review Evidence/Forms/AllItems.aspx\"}"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
